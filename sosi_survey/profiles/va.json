    },
    {
      "path": "KVALITET.NØYAKTIGHET",
      "label": "Nøyaktighet i plan (cm)",
      "type": "integer",
      "required": true,
      "min": 0
    },
    {
      "path": "KVALITET.H-MÅLEMETODE",
      "label": "Høydemålemetode (kode)",
      "type": "integer",
      "required": false,
      "min": 0
    },
    {
      "path": "KVALITET.H-NØYAKTIGHET",
      "label": "Høydenøyaktighet (cm)",
      "type": "integer",
      "required": false,
      "min": 0
    }
  ]
