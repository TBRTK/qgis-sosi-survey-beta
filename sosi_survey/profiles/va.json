{
  "schema_version": 1,
  "id": "va_utkast",
  "name": "VA – foreløpig 3D-profil",
  "approved": false,
  "require_z": true,
  "compact_groups": {
    "KVALITET": [
      "MÅLEMETODE",
      "NØYAKTIGHET",
      "SYNBARHET",
      "H-MÅLEMETODE",
      "H-NØYAKTIGHET"
    ]
  },
  "description": "VA-sjablong med samme minimale prøvefelt som bygg/anlegg. Ikke en VA-produktspesifikasjon. Funksjon, materiale, dimensjon, objekttyper og forbindelser må tilpasses ledningseiers krav.",
